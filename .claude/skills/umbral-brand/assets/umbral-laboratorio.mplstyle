#
# v1.0's umbral.mplstyle set xtick/ytick colour to the caption token at 2.37:1
# and used it as the third series. Both are corrected here — see
# audit/2026-07-conformance.md §3.5 and open-questions.md OQ-008.

figure.facecolor: none
axes.facecolor: none
axes.edgecolor: c4c9c4
axes.linewidth: 1
axes.grid: True
axes.grid.axis: y
grid.color: e6e8e4
grid.linewidth: 1
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
font.family: IBM Plex Sans
font.size: 12
axes.titlesize: 16
axes.titleweight: medium
axes.titlelocation: left
xtick.color: 6c706d
ytick.color: 6c706d
xtick.labelsize: 12
ytick.labelsize: 12
text.color: 16191c
axes.prop_cycle: cycler('color', ['128273', '5a63d8', '565d57', 'c8503f', '902a00', '6331a0'])
